{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mesh LLM Desktop",
  "mainBinaryName": "mesh-llm-desktop",
  "identifier": "cloud.meshllm.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Mesh LLM",
        "url": "index.html",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 560,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "msi",
      "nsis",
      "appimage",
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Run a Mesh LLM node from your desktop",
    "longDescription": "Mesh LLM pools GPUs across machines into one OpenAI-compatible API. This app starts a local node, keeps it running from the system tray, and shows the Mesh LLM console.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/mesh-llm-sidecar"
    ],
    "resources": {
      "binaries/native-runtimes/": "native-runtimes/"
    },
    "linux": {
      "deb": {
        "depends": []
      }
    },
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
